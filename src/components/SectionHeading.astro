---
import Icon from './Icon.astro';

interface Props {
  id: string;
  icon: 'briefcase' | 'code' | 'user' | 'mail';
  title: string;
  lead?: string;
}
const { id, icon, title, lead } = Astro.props;
---

<div class="mb-10 sm:mb-14" data-reveal>
  <h2
    id={id}
    class="flex items-center gap-x-3 scroll-mt-28 text-3xl font-bold tracking-tight sm:text-4xl"
  >
    <Icon name={icon} size={30} class="shrink-0 text-accent" />
    {title}
  </h2>
  {
    lead && (
      <p class="mt-4 max-w-2xl text-balance text-base leading-relaxed text-muted sm:text-lg">
        {lead}
      </p>
    )
  }
  {/* Short accent underline, like the reference. */}
  <div class="mt-4 h-px w-20 bg-gradient-to-r from-accent/70 to-transparent" aria-hidden="true"></div>
</div>
