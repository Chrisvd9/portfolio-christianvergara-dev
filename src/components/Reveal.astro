---
/**
 * Entrance-animation wrapper. Adds `data-reveal`; a single shared
 * IntersectionObserver (script below, emitted once) sets `data-revealed`
 * when the element scrolls into view. All motion is CSS (see global.css),
 * and it is fully disabled under `prefers-reduced-motion`.
 */
interface Props {
  as?: keyof HTMLElementTagNameMap;
  delay?: number;
  class?: string;
}

const { as: Tag = 'div', delay = 0, class: className } = Astro.props;

---

<Tag
  data-reveal
  class={className}
  style={delay ? `--reveal-delay:${delay}ms` : undefined}
>
  <slot />
</Tag>

<script>
  const setup = () => {
    const els = document.querySelectorAll<HTMLElement>('[data-reveal]:not([data-revealed])');
    if (!els.length) return;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce) {
      els.forEach((el) => el.setAttribute('data-revealed', ''));
      return;
    }

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.setAttribute('data-revealed', '');
            io.unobserve(entry.target);
          }
        }
      },
      { rootMargin: '0px 0px -8% 0px', threshold: 0.1 },
    );

    els.forEach((el) => {
      const rect = el.getBoundingClientRect();
      if (rect.top < window.innerHeight * 0.92) {
        el.setAttribute('data-revealed', '');
      } else {
        io.observe(el);
      }
    });
  };

  setup();
  document.addEventListener('astro:after-swap', setup);
</script>
